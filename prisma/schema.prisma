  closed
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum ApplicationStatus {
  new
  screening
  interview
  offer
  hired
  rejected
}

enum LocationType {
  headquarters
  regional_office
  mine
  sourcing_location
  supplier
  processing_facility
  warehouse
  port_terminal
  market
  trading_destination
  representative
}


// Hamsavahin CMS database schema (PostgreSQL).
//
// Conventions
//  - Primary keys: UUID v7 (time-ordered, index friendly, not guessable like serial ids).
//  - Every table has createdAt/updatedAt unless it is append-only (ActivityLog) or a pure join table.
//  - Enum members are lowercase so API values equal the values the admin UI already uses.
//  - Slugs/codes/emails are stored normalised (lowercase / uppercase) by the server and are UNIQUE.
//  - Foreign keys: `Restrict` where deleting the parent would orphan or destroy business/personal data;
//    `Cascade` only for pure children (specifications, role permissions, notes); `SetNull` for optional
//    attribution (assignee, author) so history survives staff leaving.
//  - Connection string comes from DATABASE_URL (see prisma.config.ts). No credentials live in this repo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum PublishStatus {
  draft
  published
  archived
}

enum UserStatus {
  active
  invited
  suspended
}

enum ChallengePurpose {
  activation
  /// Emailed one-time code that completes sign-in for roles that require a second factor (AUTH_MFA_METHOD=email).
  login
}

enum RoleStatus {
  active
  inactive
}

/// Record-level scope of a grant. "assigned" = only records assigned to the user (RFQs, enquiries).
enum GrantScope {
  all
  assigned
}

enum OverrideEffect {
  allow
  deny
}

enum UserTokenType {
  invite
  password_reset
  /// Issued after a correct email OTP; lets the employee set their first password (single use, short lived).
  activation_grant
}

enum PostCategory {
  market_insight
  company_news
  sustainability
  industry_report
}

enum ProjectStage {
  planning
  active
  completed
  on_hold
}

enum CareerStatus {

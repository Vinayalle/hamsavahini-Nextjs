enum NotificationStatus {
  queued
  sent
  failed
}

enum ActivityAction {
  created
  updated
  deleted
  published
  archived
  status_changed
  login
  login_failed
  logout
  viewed_sensitive
  access_changed
  invited
  password_reset
  otp_requested
  otp_verified
  otp_failed
  mfa_enrolled
  mfa_disabled
  mfa_reset
  mfa_failed

# Copy to `.env` (git-ignored) and fill in. Never commit real values. Everything below is a PLACEHOLDER.

# PostgreSQL connection string. In production use your managed database and require TLS (?sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hamsavahin"

# "mock" (default): the UI uses in-browser mock services, no backend needed.
# "api":  the database-backed API with real server-side authentication and authorization.
# NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_DATA_SOURCE="mock"

# Public base URL used in links inside emails (activation, password reset). Required in production.
APP_BASE_URL="https://admin.example.com"

# Seed only: initial Super Admin. If SEED_ADMIN_PASSWORD is empty the seed generates a random one and prints it once.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ───────────────────────── Authentication secrets (REQUIRED in api mode) ─────────────────────────
# Three DIFFERENT random 256-bit values, base64url. Generate with:   npm run auth:secrets            (writes missing ones to .env)
#                                                              or:   npm run auth:secrets -- --print (prints, for a secret manager)
# AUTH_JWT_SECRET      signs access tokens (HS256).
# AUTH_OTP_PEPPER      keys the HMAC that protects stored one-time codes and MFA recovery codes.
# AUTH_ENCRYPTION_KEY  AES-256-GCM key (exactly 32 bytes) that encrypts TOTP secrets at rest.
AUTH_JWT_SECRET=""
AUTH_OTP_PEPPER=""
AUTH_ENCRYPTION_KEY=""

# ───────────────────────── Authentication tuning (all optional; defaults shown) ─────────────────────────
# AUTH_JWT_ISSUER="hamsavahin-admin"
# AUTH_JWT_AUDIENCE="hamsavahin-admin-api"
# AUTH_ACCESS_TTL_SECONDS=900              # access token lifetime
# AUTH_REFRESH_TTL_SECONDS=28800           # idle window: session ends if unused this long
# AUTH_SESSION_ABSOLUTE_SECONDS=86400      # hard cap regardless of activity
# AUTH_REFRESH_GRACE_SECONDS=10            # tolerated double-refresh race (not treated as theft)
# AUTH_OTP_TTL_SECONDS=600              # how long an emailed code stays valid (max 900)
# AUTH_MFA_PENDING_TTL_SECONDS=600         # keep >= the code lifetime
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# AUTH_REAUTH_WINDOW_SECONDS=300           # "recent authentication" window for high-risk actions
# AUTH_MFA_METHOD="email"                 # second sign-in step: "email" = a 6-digit code emailed to EVERY employee at each sign-in (default,
#                                        # needs working SMTP); "totp" = authenticator app, only for the roles below
# AUTH_MFA_ROLE_CODES="super_admin,admin"  # (totp only) roles that must use an authenticator app
# AUTH_MFA_ISSUER="Hamsavahin Admin"       # name shown in authenticator apps
# AUTH_TRUST_PROXY=false                   # true ONLY behind a reverse proxy that overwrites X-Forwarded-For
# AUTH_SECURE_COOKIES=false                # always forced on in production (requires HTTPS)

# ───────────────────────── Email (nodemailer over SMTP) ─────────────────────────
# Minimum: the sending account and its password. For Gmail use an "App password" (Google account > Security > 2-Step Verification).
# Defaults when only these two are set: host smtp.gmail.com, port 465 (TLS), sender = SMTP_USER.
# Without them emails are NOT sent (the app reports "not delivered"; OTP activation then cannot be completed).
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="your-app-password"
# Optional, only for a different provider or a different sender name:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587                  # 465 = implicit TLS; 587 = STARTTLS (required unless SMTP_REQUIRE_TLS=false)
# MAIL_FROM="Hamsavahin <no-reply@example.com>"

# ───────────────────────── File storage ─────────────────────────
# Media, documents, resumes, banners and product files are saved on disk inside the project, in <project>/uploads (no bucket, no cloud).
# Files are never public: the app serves them through permission-checked routes. Keep this folder on a persistent, backed-up disk.
# UPLOAD_DIR=                      # media, documents, resumes. Default: <project>/uploads

# Banner pictures are saved on local disk inside the project (no bucket needed). Default: <project>/uploads/banners
# BANNER_UPLOAD_DIR=

# Product pictures and documents are saved the same way. Default: <project>/uploads/products
# PRODUCT_UPLOAD_DIR=

# Max database connections per server process. Default: 4 in `npm run dev`, 10 in production. Lower it if your host reports
# "max clients reached" (Supabase session pooler allows 15 clients in total across everything that is connected).
# DATABASE_POOL_MAX=4
